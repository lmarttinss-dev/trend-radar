# Chave de API do Anthropic — obrigatória para análise LLM
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-SUBSTITUA_PELA_SUA_CHAVE

# Chave de API do Google Gemini (obrigatória se LLM_MODEL=gemini-2.5-flash)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Modelo LLM a usar (padrão: claude-haiku-4-5)
# Opções: claude-haiku-4-5 | gemini-2.5-flash
LLM_MODEL=claude-haiku-4-5

# Habilita/desabilita análise LLM (padrão: true)
# Use LLM_ENABLED=false para rodar apenas com heurística
LLM_ENABLED=true

# Número máximo de vídeos por hashtag (padrão: 20)
LIMIT=20

# Roda browser sem janela (padrão: false — janela visível evita bloqueios)
HEADLESS=false

# Categorias do Mercado Livre a scraping (separadas por vírgula)
# Opções disponíveis: beleza,esportes,games,eletronicos,celulares,informatica
ML_CATEGORIAS=beleza,esportes,games,eletronicos,celulares

# Habilita busca de fornecedores no Alibaba (Trade Assurance + Verified Supplier)
# Requer LLM_ENABLED=true (usa os produtos viáveis do pipeline LLM)
ALIBABA_ENABLED=true

# Número máximo de fornecedores por produto (padrão: 3)
ALIBABA_LIMITE=3
